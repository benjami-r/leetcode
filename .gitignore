#My. Корень проекта - место .git, .gitignore. Идет сверху вниз. Игнорим:
# file      - filefold, где бы ни был
# /file     - filefold, здесь "/" - с корня
# fold/	    - именно fold, где бы ни был
# /fold/    - именно fold, но только в корне
# logs/**/*.log - в logs/ все .log любой вложенности
# !file     - но не file (исключить, отменяет для него предыдущие рулсы)
# $ git rm --cached <file> - удалить из индекса
#
# ВПИСАТЬ ЕЩЕ ПОЛЕЗНЫХ КОМАНД! ШПАРГАЛКА
#

build/
.cache/
.vscode/
.idea/
