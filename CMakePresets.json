{
	"version": 6,
	"configurePresets": [
		{
			"name": "base",
      		"hidden": true,
      		"generator": "Ninja",
      		"binaryDir": "${sourceDir}/build",
					"cacheVariables": {
					    "CMAKE_C_COMPILER": "clang",
					    "CMAKE_CXX_COMPILER": "clang++"
					  }
      	},
      	{
			"name": "debug",
			"inherits": "base",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Debug"
			}
		},
		{
			"name": "release",
			"inherits": "base",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Release"
			}
		}
	],
	"buildPresets": [
	    {
	      "name": "default",
	      "configurePreset": "debug"
	    },
	    {
	      "name": "debug",
	      "configurePreset": "debug"
	    },
	    {
	      "name": "release",
	      "configurePreset": "release"
	    }
	]
}
